# Configuration serveur MySQL — montée dans le conteneur (/etc/mysql/conf.d/jobpilot.cnf)
[mysqld]
character-set-server    = utf8mb4
collation-server        = utf8mb4_0900_ai_ci
default-time-zone       = '+00:00'            # ADR-07 : tout en UTC
sql_mode                = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY
# Binlogs (ADR-10) : rendent possible une restauration à un instant donné (PITR)
log_bin                 = /var/lib/mysql/binlog
binlog_expire_logs_seconds = 1209600          # 14 jours > rétention nécessaire entre deux sauvegardes
# Journal des requêtes lentes pour ENF-PERF-04
slow_query_log          = ON
long_query_time         = 0.5
log_queries_not_using_indexes = ON
innodb_buffer_pool_size = 256M
