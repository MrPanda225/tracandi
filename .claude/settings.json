{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run db:migrate)",
      "Bash(npx vitest:*)",
      "Bash(npx prettier:*)",
      "Bash(npm audit:*)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(scripts/db/backup.sh)",
      "Bash(scripts/db/restore-check.sh:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose up:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./database/conf/backup.cnf)",
      "Read(./database/conf/restore.cnf)",
      "Read(./backend/data/profile.json)",
      "Bash(cat .env:*)",
      "Bash(rm -rf:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(scripts/db/restore.sh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edits.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.mjs\"" }]
      }
    ]
  }
}
