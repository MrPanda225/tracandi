# Copier en .env — ce fichier n'est JAMAIS commité ni lu par Claude Code.
# Commentaires sur leur propre ligne uniquement : les parseurs (Node --env-file, Docker Compose) diffèrent sur les commentaires en fin de ligne.

# ---------- Base de données : Neon (PostgreSQL hébergé, région UE — C-02, ADR-11) ----------
# Une chaîne de connexion par rôle, révocable séparément (ENF-SEC-17).
# Toujours terminer par ?sslmode=verify-full : le backend refuse de démarrer sinon (ENF-SEC-15).
# Console Neon → Connect → choisir le rôle.
# Format : postgresql://<rôle>:<mot de passe>@<hôte>.eu-central-1.aws.neon.tech/<base>?sslmode=verify-full
#
# Backend (DML seulement) — hôte « -pooler » (connexions mutualisées)
DATABASE_URL_APP=
# Service migrate (propriétaire du schéma, DDL) — hôte direct, sans « -pooler »
DATABASE_URL_MIGRATOR=
# Sauvegarde pg_dump (lecture seule) — hôte direct, sans « -pooler »
DATABASE_URL_BACKUP=

# ---------- Comptes (ADR-09) ----------
# Cookie de session « Secure » : laisser true (les navigateurs l'acceptent sur http://127.0.0.1 et http://localhost)
COOKIE_SECURE=true

# ---------- Base locale de test (PostgreSQL en Docker, ADR-12) ----------
# Utilisée uniquement par les tests d'intégration et la restauration de contrôle ; jamais de donnée réelle.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=tracandi_test
TEST_DB_USER=tracandi_test
# Base jetable sans donnée réelle : valeur par défaut tracandi_test si vide (docker-compose.yml)
TEST_DB_PASSWORD=

# ---------- IA (au moins une clé ; chaque clé renseignée exige son modèle, EF-IA-05) ----------
# Ordre d'appel (RG-13 v1.8) : les trois emplacements Groq (gratuits), puis Gemini, puis Claude.
# Modèles Groq disponibles pour votre clé :
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Les trois emplacements sont essayés dans l'ordre ; un emplacement vide est ignoré.
GROQ_API_KEY=
GROQ_MODEL_1=openai/gpt-oss-120b
GROQ_MODEL_2=qwen/qwen3.8-27b
GROQ_MODEL_3=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
# gemini-2.5-flash n'est plus ouvert aux nouveaux comptes (404 NOT_FOUND) : utiliser gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# ---------- Gmail OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
GMAIL_APPLY_LABELS=true
GMAIL_INITIAL_LOOKBACK_DAYS=120

# ---------- Application ----------
# Adresse d'écoute : 127.0.0.1 en local ; 0.0.0.0 dans le conteneur (port publié sur 127.0.0.1 seulement, ENF-SEC-01)
HOST=127.0.0.1
PORT=4000
# Doit correspondre exactement à l'adresse ouverte dans le navigateur (ENF-SEC-11)
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Clé AES-256-GCM du jeton OAuth (ENF-SEC-02) : openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Adresse de contact dans l'agent utilisateur de la veille (ENF-COL-03)
SCRAPER_CONTACT_EMAIL=
# RG-06 : jours sans activité avant relance
FOLLOW_UP_DAYS=10
# EF-VEI-15 : score minimum déclenchant le récapitulatif
OFFER_ALERT_THRESHOLD=60

# ---------- Fonctionnalités ----------
# ENF-MAI-07 : fonctionnalités facultatives, séparées par des virgules : watch (veille des offres), cv (Atelier CV).
# Vide (main et dev) : seuls le tableau de bord, les candidatures, Gmail et les réglages sont servis ; les autres
# écrans affichent « En préparation ». Pour travailler sur la veille ou le CV : ENABLED_FEATURES=watch,cv
ENABLED_FEATURES=

# ---------- Planification ----------
# Fuseau des expressions cron (EF-VEI-06 : heure de Paris), passé à node-cron
SCHEDULER_TIMEZONE=Europe/Paris
# EF-GML-03
CRON_GMAIL="*/30 * * * *"
# EF-VEI-06
CRON_SCRAPER="0 7,13,19 * * *"

# ---------- Informations légales (EF-LEG-01) ----------
# Affichées dans les mentions légales et la politique de confidentialité ; vides : « à compléter ».
VITE_LEGAL_PUBLISHER=
VITE_LEGAL_CONTACT=
# Hébergeur de l'application (nom et adresse), une fois choisi (Q-18)
VITE_LEGAL_HOST=
